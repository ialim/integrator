APP_NAME=integrator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON log lines, each carrying the request id.
LOG_CHANNEL=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 is the only supported database. These values reach the
# compose-published port from the host; compose.yaml points the app container
# at the `pgsql` service on 5432 instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=integrator
DB_USERNAME=integrator
DB_PASSWORD=secret

# The database driver backs sessions, cache, locks, rate limits and the queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Founder alerts (docs/operations/alerts.md). Production sets these in the host's secret store.
FOUNDER_ALERT_EMAIL=
ALERTS_MAILER=

# Object storage (Laravel Cloud's bucket in production).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The offsite backup bucket, for inspecting copies by hand from the app
# container. Locally this is the compose MinIO, reached as `minio` inside the
# compose network; production's app never gets these (only the backup runner does).
OFFSITE_S3_ENDPOINT=http://minio:9000
OFFSITE_S3_REGION=auto
OFFSITE_S3_BUCKET=integrator-offsite
OFFSITE_S3_ACCESS_KEY_ID=integrator
OFFSITE_S3_SECRET_ACCESS_KEY=integrator-local
OFFSITE_S3_PREFIX=
OFFSITE_S3_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
